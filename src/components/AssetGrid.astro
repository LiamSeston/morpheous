---
import AssetCard from './AssetCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entries: CollectionEntry<'assets'>[];
}

const { entries } = Astro.props;
---

<div class="asset-grid" id="asset-grid">
	{entries.map((entry) => (
		<AssetCard entry={entry} />
	))}
	<p class="empty-state is-hidden" id="empty-state">No pieces match the current filters.</p>
</div>

<script>
	function setupFilters() {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.asset-card'));
		if (cards.length === 0) return;
		const emptyState = document.getElementById('empty-state');

		// Each facet maps a set of controls (pills, and the catalog's system
		// tiles) onto a data-attribute carried by every card.
		const facets = [
			{ name: 'system', attr: 'data-filter-system', prop: 'filterSystem', cardProp: 'system' },
			{ name: 'kind', attr: 'data-filter-kind', prop: 'filterKind', cardProp: 'kind' },
			{ name: 'scan', attr: 'data-filter-scan', prop: 'filterScan', cardProp: 'scan' },
		];

		const active: Record<string, string> = { system: 'all', kind: 'all', scan: 'all' };

		function applyFilters() {
			let visibleCount = 0;

			cards.forEach((card) => {
				const visible = facets.every(
					(facet) =>
						active[facet.name] === 'all' || card.dataset[facet.cardProp] === active[facet.name],
				);
				card.classList.toggle('is-hidden', !visible);
				if (visible) visibleCount += 1;
			});

			emptyState?.classList.toggle('is-hidden', visibleCount > 0);
		}

		facets.forEach((facet) => {
			const controls = Array.from(document.querySelectorAll<HTMLElement>(`[${facet.attr}]`));

			controls.forEach((control) => {
				control.addEventListener('click', () => {
					const value = control.dataset[facet.prop] ?? 'all';
					active[facet.name] = value;

					// Sync by value, not identity, so a pill and its matching
					// system tile stay highlighted together.
					controls.forEach((other) =>
						other.classList.toggle('is-active', (other.dataset[facet.prop] ?? 'all') === value),
					);

					applyFilters();
				});
			});
		});
	}

	setupFilters();
	document.addEventListener('astro:page-load', setupFilters);
</script>
