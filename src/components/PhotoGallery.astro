---
interface Props {
	images?: string[];
	title: string;
}

const { images = [], title } = Astro.props;
const base = import.meta.env.BASE_URL;

function resolveImage(path: string) {
	return path.startsWith('http') ? path : `${base}${path.replace(/^\//, '')}`;
}

const resolved = images.map(resolveImage);
const [hero, ...rest] = resolved;
---

{hero ? (
	<div class="detail-hero">
		<img src={hero} alt={title} width="1200" height="675" />
	</div>
) : (
	<p><em>No 3D scan yet for this piece.</em></p>
)}

{
	rest.length > 0 && (
		<section class="gallery">
			<h2>Gallery</h2>
			<div class="gallery-grid">
				{rest.map((src, index) => (
					<img src={src} alt={`${title} photo ${index + 2}`} loading="lazy" width="400" height="300" />
				))}
			</div>
		</section>
	)
}

<style>
	.detail-hero {
		margin-bottom: 1.5rem;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid var(--line);
	}
	.detail-hero img {
		width: 100%;
		max-height: 480px;
		object-fit: cover;
	}
</style>
