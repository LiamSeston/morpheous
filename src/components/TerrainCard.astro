---
import StatusBadge from './StatusBadge.astro';
import TypeBadge from './TypeBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'terrain'>;
}

const { entry } = Astro.props;
const { title, type, status, dimensions, heroImage } = entry.data;
const href = `${import.meta.env.BASE_URL}terrain/${entry.id}/`;
const imageSrc = heroImage ? `${import.meta.env.BASE_URL}${heroImage.replace(/^\//, '')}` : null;
---

<a
	class="terrain-card"
	href={href}
	data-type={type}
	data-status={status}
>
	<div class="terrain-card__image">
		{imageSrc ? (
			<img src={imageSrc} alt={title} loading="lazy" width="400" height="300" />
		) : (
			<div class="terrain-card__placeholder">No photo yet</div>
		)}
	</div>
	<div class="terrain-card__body">
		<h2 class="terrain-card__title">{title}</h2>
		<div class="terrain-card__meta">
			<TypeBadge type={type} />
			<StatusBadge status={status} />
		</div>
		{dimensions && <p class="terrain-card__dimensions">{dimensions}</p>}
	</div>
</a>
