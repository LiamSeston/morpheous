---
interface Props {
	status: 'planned' | 'in-progress' | 'complete';
}

const { status } = Astro.props;

const labels: Record<Props['status'], string> = {
	planned: 'Planned',
	'in-progress': 'In Progress',
	complete: 'Complete',
};
---

<span class={`status-badge status-${status}`}>{labels[status]}</span>
