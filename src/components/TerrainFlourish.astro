---
// src/components/TerrainFlourish.astro
// The one icon sourced from game-icons.net rather than Tabler — used only
// as a decorative category marker (catalog headers, section dividers),
// never as inline UI chrome. Kept filled/bold on purpose, matching that
// library's native style rather than forcing it into the thin-line spec.
//
// Requires attribution — see ICONS.md.

interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
>
  <path d="M9 22 L9 12 L7 12 L7 8 L10 4 L10 8 L14 8 L14 4 L17 8 L17 12 L15 12 L15 22 Z M4 22 L20 22 L20 20 L4 20 Z"/>
</svg>
