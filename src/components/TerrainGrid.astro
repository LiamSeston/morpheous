---
import TerrainCard from './TerrainCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entries: CollectionEntry<'terrain'>[];
}

const { entries } = Astro.props;
---

<div class="terrain-grid" id="terrain-grid">
	{entries.map((entry) => (
		<TerrainCard entry={entry} />
	))}
	<p class="empty-state is-hidden" id="empty-state">No terrain pieces match the current filters.</p>
</div>

<script>
	function setupFilters() {
		const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-type]');
		const statusButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-status]');
		const cards = document.querySelectorAll<HTMLElement>('.terrain-card');
		const emptyState = document.getElementById('empty-state');

		let activeType = 'all';
		let activeStatus = 'all';

		function applyFilters() {
			let visibleCount = 0;

			cards.forEach((card) => {
				const cardType = card.dataset.type;
				const cardStatus = card.dataset.status;
				const typeMatch = activeType === 'all' || cardType === activeType;
				const statusMatch = activeStatus === 'all' || cardStatus === activeStatus;
				const visible = typeMatch && statusMatch;

				card.classList.toggle('is-hidden', !visible);
				if (visible) visibleCount += 1;
			});

			emptyState?.classList.toggle('is-hidden', visibleCount > 0);
		}

		function setActive(buttons: NodeListOf<HTMLButtonElement>, active: HTMLButtonElement) {
			buttons.forEach((btn) => btn.classList.toggle('is-active', btn === active));
		}

		typeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				activeType = button.dataset.filterType ?? 'all';
				setActive(typeButtons, button);
				applyFilters();
			});
		});

		statusButtons.forEach((button) => {
			button.addEventListener('click', () => {
				activeStatus = button.dataset.filterStatus ?? 'all';
				setActive(statusButtons, button);
				applyFilters();
			});
		});
	}

	setupFilters();
	document.addEventListener('astro:page-load', setupFilters);
</script>
