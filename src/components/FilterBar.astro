---
import type { CollectionEntry } from 'astro:content';

interface Props {
	entries: CollectionEntry<'assets'>[];
}

const { entries } = Astro.props;

const systems = [...new Set(entries.map((e) => e.data.system))].sort();
const kinds = [...new Set(entries.map((e) => e.data.category.split('—')[0].trim()))].sort();
const hasAnyScan = entries.some((e) => e.data.modelSrc);
---

<div class="filter-bar">
	<div class="filter-group">
		<span class="filter-label" id="filter-system-label">System</span>
		<button type="button" class="filter-btn is-active" data-filter-system="all" aria-labelledby="filter-system-label">
			All
		</button>
		{systems.map((system) => (
			<button type="button" class="filter-btn" data-filter-system={system} aria-labelledby="filter-system-label">
				{system}
			</button>
		))}
	</div>

	<div class="filter-group">
		<span class="filter-label" id="filter-kind-label">Type</span>
		<button type="button" class="filter-btn is-active" data-filter-kind="all" aria-labelledby="filter-kind-label">
			All
		</button>
		{kinds.map((kind) => (
			<button type="button" class="filter-btn" data-filter-kind={kind} aria-labelledby="filter-kind-label">
				{kind}
			</button>
		))}
	</div>

	{hasAnyScan && (
		<div class="filter-group">
			<span class="filter-label" id="filter-scan-label">Detail</span>
			<button type="button" class="filter-btn is-active" data-filter-scan="all" aria-labelledby="filter-scan-label">
				All
			</button>
			<button type="button" class="filter-btn" data-filter-scan="scan" aria-labelledby="filter-scan-label">
				Has 3D scan
			</button>
			<button type="button" class="filter-btn" data-filter-scan="photo" aria-labelledby="filter-scan-label">
				Photos only
			</button>
		</div>
	)}
</div>
