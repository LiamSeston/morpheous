<div class="filter-bar">
	<div class="filter-group">
		<span id="filter-type-label">Type</span>
		<button type="button" class="filter-btn is-active" data-filter-type="all" aria-labelledby="filter-type-label">
			All
		</button>
		<button type="button" class="filter-btn" data-filter-type="building" aria-labelledby="filter-type-label">
			Building
		</button>
		<button type="button" class="filter-btn" data-filter-type="scatter" aria-labelledby="filter-type-label">
			Scatter
		</button>
		<button type="button" class="filter-btn" data-filter-type="tile" aria-labelledby="filter-type-label">
			Tile
		</button>
		<button type="button" class="filter-btn" data-filter-type="bridge" aria-labelledby="filter-type-label">
			Bridge
		</button>
		<button type="button" class="filter-btn" data-filter-type="other" aria-labelledby="filter-type-label">
			Other
		</button>
	</div>

	<div class="filter-group">
		<span id="filter-status-label">Status</span>
		<button type="button" class="filter-btn is-active" data-filter-status="all" aria-labelledby="filter-status-label">
			All
		</button>
		<button type="button" class="filter-btn" data-filter-status="planned" aria-labelledby="filter-status-label">
			Planned
		</button>
		<button
			type="button"
			class="filter-btn"
			data-filter-status="in-progress"
			aria-labelledby="filter-status-label"
		>
			In Progress
		</button>
		<button type="button" class="filter-btn" data-filter-status="complete" aria-labelledby="filter-status-label">
			Complete
		</button>
	</div>
</div>
