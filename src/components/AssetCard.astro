---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
	entry: CollectionEntry<'assets'>;
}

const { entry } = Astro.props;
const { title, system, category, materials, footprint, warpstoneTouched, images, modelSrc } =
	entry.data;
const [categoryRoot] = category.split('—').map((s) => s.trim());
const base = import.meta.env.BASE_URL;
const href = withBase(base, `assets/${entry.id}/`);

const gradients = [
	'linear-gradient(155deg,var(--model-a),var(--model-c))',
	'linear-gradient(155deg,var(--model-b),var(--model-d))',
	'linear-gradient(155deg,var(--model-c),var(--model-a))',
	'linear-gradient(155deg,var(--model-d),var(--model-b))',
];
const gradient = gradients[title.length % gradients.length];

const photo = images[0];
const imageSrc = photo ? (photo.startsWith('http') ? photo : withBase(base, photo)) : null;
---

<a
	class="asset-card"
	href={href}
	data-system={system}
	data-kind={categoryRoot}
	data-scan={modelSrc ? 'scan' : 'photo'}
>
	<div class="asset-thumb" style={imageSrc ? undefined : `background:${gradient}`}>
		{imageSrc && <img src={imageSrc} alt={title} loading="lazy" width="400" height="300" />}
	</div>
	<div class="asset-body">
		<div class="tag-row">
			<span class="tag">{categoryRoot}</span>
			<span class="tag system">{system}</span>
			{warpstoneTouched && <span class="tag warp">Warpstone-touched</span>}
		</div>
		<h3>{title}</h3>
		<p>{[materials.slice(0, 2).join(' + '), footprint].filter(Boolean).join(' — ')}</p>
	</div>
</a>
