---
// src/components/Icon.astro
// Usage: <Icon name="terrain" size={20} />
//
// Every icon here is pre-styled to the house spec (square caps, mitered
// joins, 1.5px stroke) directly in the markup, so no external CSS override
// is needed — swap or add icons here and they inherit the style automatically.

interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

// --- Tabler-sourced (MIT, no attribution needed) ---
// Pull the real SVG path data from https://tabler.io/icons or the
// @tabler/icons npm package — these are close approximations to swap in.
const icons = {
  viewport3d: `<path d="M12 3 19 7 19 17 12 21 5 17 5 7 12 3Z"/><path d="M4 12 A8 3.4 0 0 0 20 12" opacity="0.7"/><path d="M17.5 10.3 L20 12 L18 14.3" opacity="0.7"/>`,
  buildLog: `<path d="M4 19.5 A2.5 2.5 0 0 1 6.5 17 H19 M6.5 2 H19 V20 H6.5 A2.5 2.5 0 0 1 4 17.5 V4.5 A2.5 2.5 0 0 1 6.5 2Z"/><path d="M9 8 L15 8 M9 11 L15 11"/>`,
  search: `<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.3 15.3 L21 21"/>`,
  download: `<path d="M4 15 V19 A2 2 0 0 0 6 21 H18 A2 2 0 0 0 20 19 V15 M12 3 V15 M12 15 L7 10 M12 15 L17 10"/>`,
  systemTag: `<path d="M11 3 L20 3 L20 12 L12 20 L4 12 L4 4 Z"/><circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none"/>`,
  resetView: `<path d="M4 12 A8 8 0 1 1 6.3 17.7"/><path d="M4 12 L4 6.5 M4 12 L9.5 12"/>`,
  autoRotate: `<path d="M12 5 A7 7 0 1 1 5.5 9"/><path d="M4 5 L5.5 9 L9.5 8"/>`,
  dragRotate: `<path d="M9 3 H5 A2 2 0 0 0 3 5 V9 M15 3 H19 A2 2 0 0 1 21 5 V9 M9 21 H5 A2 2 0 0 1 3 19 V15 M15 21 H19 A2 2 0 0 0 21 19 V15"/>`,
  file3d: `<path d="M6 4 L6 20 L18 20 L18 8 L14 4 Z M14 4 L14 8 L18 8"/>`,
  lightMode: `<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M4.5 4.5l2 2M17.5 17.5l2 2M2 12h3M19 12h3M4.5 19.5l2-2M17.5 6.5l2-2"/>`,
  darkMode: `<path d="M20 13.5 A8 8 0 1 1 10.5 4 A6.2 6.2 0 0 0 20 13.5Z"/>`,
};

const isFilled = false; // all Tabler-sourced icons use stroke, not fill
const svgContent = icons[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  set:html={svgContent}
/>
