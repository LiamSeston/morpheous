---
// src/components/ThemeToggle.astro
// Usage: <ThemeToggle /> anywhere in your top nav.
// The no-flash theme-detection script runs once, in BaseLayout.astro's
// <head> — this component only owns the click handler.
---

<button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
  <span class="icon" id="themeIcon"></span>
  <span id="themeLabel">Dark mode</span>
</button>

<style>
  .theme-toggle {
    margin-left: auto;
    display: flex; align-items: center; gap: 8px;
    padding: 7px 12px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 20px; cursor: pointer;
    font-family: var(--font-ui); font-size: 12.5px; font-weight: 600;
    color: var(--text-dim);
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--text); }
  .theme-toggle .icon { width: 15px; height: 15px; display: flex; }
  .theme-toggle svg { width: 100%; height: 100%; }
</style>

<script>
  const btn = document.getElementById('themeToggle');
  const label = document.getElementById('themeLabel');
  const iconEl = document.getElementById('themeIcon');

  // House icon spec (square caps, mitered joins, 1.5px stroke) — matches
  // Icon.astro's lightMode/darkMode entries. Duplicated here as raw markup
  // rather than importing the component, since this runs client-side after
  // hydration rather than at build time.
  const sunIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M4.5 4.5l2 2M17.5 17.5l2 2M2 12h3M19 12h3M4.5 19.5l2-2M17.5 6.5l2-2"/></svg>';
  const moonIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M20 13.5 A8 8 0 1 1 10.5 4 A6.2 6.2 0 0 0 20 13.5Z"/></svg>';

  function syncLabel() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    label.textContent = isDark ? 'Light mode' : 'Dark mode';
    iconEl.innerHTML = isDark ? sunIcon : moonIcon;
  }
  syncLabel();

  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const next = isDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('morpheous-theme', next);
    syncLabel();
  });

  document.addEventListener('astro:page-load', syncLabel);
</script>
