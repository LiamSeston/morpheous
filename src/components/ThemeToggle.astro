---
// src/components/ThemeToggle.astro
// Usage: <ThemeToggle /> anywhere in your top nav.
// The no-flash theme-detection script runs once, in BaseLayout.astro's
// <head> — this component only owns the click handler.
---

<button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
  <span class="icon" id="themeIcon"></span>
  <span id="themeLabel">Dark mode</span>
</button>

<style>
  .theme-toggle {
    margin-left: auto;
    display: flex; align-items: center; gap: 8px;
    padding: 7px 12px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 20px; cursor: pointer;
    font-family: var(--font-ui); font-size: 12.5px; font-weight: 600;
    color: var(--text-dim);
    /* Squeezed into a cramped header this otherwise breaks across two
       lines mid-phrase ("Dark / mode") and drags the header height with it. */
    white-space: nowrap;
    flex-shrink: 0;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--text); }
  .theme-toggle .icon { width: 15px; height: 15px; display: flex; }
  .theme-toggle svg { width: 100%; height: 100%; }
</style>

<script>
  const btn = document.getElementById('themeToggle');
  const label = document.getElementById('themeLabel');
  const iconEl = document.getElementById('themeIcon');

  const sunIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
  const moonIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.6A9 9 0 1111.4 3a7 7 0 009.6 9.6z"/></svg>';

  function syncLabel() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    label.textContent = isDark ? 'Light mode' : 'Dark mode';
    iconEl.innerHTML = isDark ? sunIcon : moonIcon;
  }

  // Keeps the browser chrome (notably the iOS Safari status bar) matching the
  // page. Reads the live --page-bg token rather than repeating the hex values —
  // by the time anyone can click, the stylesheet has applied. The pre-paint
  // default is set by the inline script in BaseLayout.astro's <head>.
  function syncThemeColor() {
    const meta = document.querySelector('meta[name="theme-color"]');
    if (!meta) return;
    const bg = getComputedStyle(document.documentElement)
      .getPropertyValue('--page-bg')
      .trim();
    if (bg) meta.setAttribute('content', bg);
  }

  syncLabel();

  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const next = isDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('morpheous-theme', next);
    syncLabel();
    syncThemeColor();
  });

  document.addEventListener('astro:page-load', () => {
    syncLabel();
    syncThemeColor();
  });
</script>
