---
// src/components/Seal.astro
// The site's brand mark — a 7-point star, replacing the earlier blackletter
// "M" mark everywhere it appeared (nav bar, hero, favicon, divider
// ornaments). 7 points specifically to avoid other symbols' associations
// (4-point reads as a generic AI-product sparkle, 5-point is the generic
// "star" cliché, 6-point can read as Star of David, 8-point is the
// Chaos-symbol count).
//
// v3: fixes a rendering bug where the mark looked fine at large size but
// fell apart at the nav bar / favicon scale it's actually used at most,
// showing a thin, disconnected-looking center. Root cause was rays
// tapering to a bare point exactly at center, plus inconsistent path
// winding between mirrored and non-mirrored rays. Every ray is now built
// from one consistent formula (no mirroring), and a small solid hub at
// the center means everything connects through something solid instead
// of a bare point.
//
// Pure vector path, no font dependency — safe to use anywhere, including
// as the favicon source, with no risk of silently falling back to a
// different glyph the way the font-based M could.
//
// Usage:
//   <Seal size={24} />            — nav bar / divider scale
//   <Seal size={46} />            — hero scale
//   <Seal size={24} class="..." />

interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  aria-hidden="true"
>
  <circle cx="12" cy="12" r="2.5"/>
  <path d="M12,12 L14.3,12 L12,1 L9.7,12 Z M12,12 L13.432,13.800 L20.609,5.152 L10.568,10.200 Z M12,12 L11.488,14.242 L22.724,14.448 L12.512,9.758 Z M12,12 L9.928,12.998 L16.773,21.911 L14.072,11.002 Z M12,12 L9.928,11.002 L7.227,21.911 L14.072,12.998 Z M12,12 L11.488,9.758 L1.276,14.448 L12.512,14.242 Z M12,12 L13.432,10.200 L3.391,5.152 L10.568,13.800 Z"/>
</svg>
