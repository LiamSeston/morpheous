---
import '../styles/theme.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Seal from '../components/Seal.astro';
import { withBase, stripBase } from '../lib/url';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'A modelling & terrain catalog spanning Mordheim, Necromunda, 40k, and whatever comes next.',
} = Astro.props;
const fullTitle = title === 'Morpheous' ? 'Morpheous' : `${title} · Morpheous`;
const base = import.meta.env.BASE_URL;
const currentPath = stripBase(base, Astro.url.pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!--
			Theme init. Deliberately the first thing in the head after charset and
			viewport, and deliberately the ONLY source of a theme-color meta tag on
			the page — there is no static one anywhere in this file, on purpose.

			Safari commits to the theme-color it sees while parsing the head and
			will not reliably repaint its chrome for a later change. So any static
			tag written here would win — and a static tag can only encode the OS
			preference, which is not the same thing as the theme the visitor picked.
			Media-scoped static tags made that worse rather than better: they pinned
			the chrome to the OS in both directions, so a dark site on a light phone
			kept a light strip and a light site on a dark phone kept a dark one.

			Running here, before any such tag exists, means the first and only value
			Safari ever reads is the resolved one. This also sets data-theme before
			first paint, which is what stops the page itself flashing the wrong
			theme. ThemeToggle.astro owns only the click handler.
		-->
		<script is:inline>
			(function () {
				// Mirrors --page-bg in theme.css. Hardcoded rather than read off
				// the custom property because this runs before the stylesheet is
				// guaranteed to have applied — keep the two in sync.
				var PAGE_BG = { light: '#EDE4D0', dark: '#0B0E0C' };

				// Leaves exactly one theme-color tag in the document.
				//
				// Clearing first matters because the browser honours the first
				// *matching* tag, so any leftover sibling could outrank the one we
				// just wrote. Inserting a fresh node rather than editing one in
				// place matters because Safari often will not repaint its chrome
				// for a `content` mutation on a tag it has already read.
				function setThemeColor(color) {
					var existing = document.querySelectorAll('meta[name="theme-color"]');
					for (var i = 0; i < existing.length; i++) existing[i].parentNode.removeChild(existing[i]);
					var meta = document.createElement('meta');
					meta.setAttribute('name', 'theme-color');
					meta.setAttribute('content', color);
					document.head.appendChild(meta);
				}

				function apply(theme) {
					document.documentElement.setAttribute('data-theme', theme);
					setThemeColor(PAGE_BG[theme] || PAGE_BG.light);
				}

				// Belt and braces. The tag installed during head parsing should
				// already be the only one Safari ever reads, but re-installing it
				// once the page is up costs nothing and covers a stale commit.
				// pageshow additionally covers bfcache restores, where iOS hands
				// back a page whose chrome colour has gone stale.
				function reassert() {
					var theme = document.documentElement.getAttribute('data-theme');
					setThemeColor(PAGE_BG[theme] || PAGE_BG.light);
				}
				document.addEventListener('DOMContentLoaded', reassert);
				window.addEventListener('load', reassert);
				window.addEventListener('pageshow', reassert);

				// Shared with ThemeToggle.astro's click handler so theme state and
				// chrome colour can only ever change together. A global is the
				// pragmatic seam here: this block must stay inline to beat first
				// paint, so the toggle's bundled module cannot import from it.
				window.__morpheousApplyTheme = apply;

				var stored = localStorage.getItem('morpheous-theme');
				var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				apply(stored || (systemDark ? 'dark' : 'light'));
			})();
		</script>

		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={withBase(base, 'favicon.svg')} />
		<link rel="icon" type="image/x-icon" href={withBase(base, 'favicon.ico')} sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" sizes="180x180" href={withBase(base, 'apple-touch-icon.png')} />
		<link rel="manifest" href={withBase(base, 'site.webmanifest')} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Pirata+One&family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<title>{fullTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="brand">
				<Seal size={24} class="seal" />
				<a href={withBase(base)} style="color:inherit;">Morpheous</a>
			</div>
			<nav class="site-nav" aria-label="Main">
				<a href={withBase(base)} aria-current={currentPath === '/' ? 'page' : undefined}>
					Home
				</a>
				<a
					href={withBase(base, 'catalog/')}
					aria-current={currentPath.startsWith('/catalog') ? 'page' : undefined}
				>
					Catalog
				</a>
				<a
					href={withBase(base, 'about/')}
					aria-current={currentPath.startsWith('/about') ? 'page' : undefined}
				>
					About
				</a>
			</nav>
			<ThemeToggle />
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-brand">Morpheous</div>
			<div>A fan-made modelling &amp; terrain catalog. Not affiliated with any publisher.</div>
		</footer>
	</body>
</html>
