---
import '../styles/theme.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Seal from '../components/Seal.astro';
import { withBase, stripBase } from '../lib/url';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'A modelling & terrain catalog spanning Mordheim, Necromunda, 40k, and whatever comes next.',
} = Astro.props;
const fullTitle = title === 'Morpheous' ? 'Morpheous' : `${title} · Morpheous`;
const base = import.meta.env.BASE_URL;
const currentPath = stripBase(base, Astro.url.pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<!--
			Colours the browser's own chrome on mobile — the iOS Safari toolbar
			and the status bar area.

			These must be *media-scoped and correct at parse time*, not a single
			light default that script fixes up afterwards: Safari reads
			theme-color while parsing <head> and routinely ignores a later
			in-place `content` mutation, so a dark-mode visitor would keep a
			light toolbar over a dark page.

			They cover the case where the site theme matches the OS. When a
			stored preference overrides the OS, the script below deletes both of
			these and inserts a single unconditional tag — see the note there for
			why it replaces rather than edits.
		-->
		<meta name="theme-color" content="#EDE4D0" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0B0E0C" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href={withBase(base, 'favicon.svg')} />
		<link rel="icon" type="image/x-icon" href={withBase(base, 'favicon.ico')} sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" sizes="180x180" href={withBase(base, 'apple-touch-icon.png')} />
		<link rel="manifest" href={withBase(base, 'site.webmanifest')} />

		<!--
			Critical for avoiding a flash of the wrong theme: this reads
			localStorage/matchMedia and sets data-theme before first paint.
			Runs once here, in <head> — ThemeToggle.astro only owns the click handler.
		-->
		<script is:inline>
			(function () {
				// Mirrors --page-bg in theme.css. Hardcoded rather than read off
				// the custom property because this runs before the stylesheet is
				// guaranteed to have applied — keep the two in sync.
				var PAGE_BG = { light: '#EDE4D0', dark: '#0B0E0C' };

				// Replaces every theme-color tag with one unconditional tag.
				//
				// Replace rather than edit, for two independent reasons:
				//   1. The static tags above are media-scoped, and the browser
				//      honours the *first matching* theme-color. Editing one in
				//      place loses to a stale sibling whenever the stored theme
				//      disagrees with the OS — e.g. dark site on a light phone.
				//   2. Safari often will not repaint its chrome for a `content`
				//      mutation on a tag it has already read, but does for a
				//      newly inserted node.
				function setThemeColor(color) {
					var existing = document.querySelectorAll('meta[name="theme-color"]');
					for (var i = 0; i < existing.length; i++) existing[i].parentNode.removeChild(existing[i]);
					var meta = document.createElement('meta');
					meta.setAttribute('name', 'theme-color');
					meta.setAttribute('content', color);
					document.head.appendChild(meta);
				}

				function apply(theme) {
					document.documentElement.setAttribute('data-theme', theme);
					setThemeColor(PAGE_BG[theme] || PAGE_BG.light);
				}

				// Shared with ThemeToggle.astro's click handler so theme state and
				// chrome colour can only ever change together. A global is the
				// pragmatic seam here: this block must stay inline to beat first
				// paint, so the toggle's bundled module cannot import from it.
				window.__morpheousApplyTheme = apply;

				var stored = localStorage.getItem('morpheous-theme');
				var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				apply(stored || (systemDark ? 'dark' : 'light'));
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Pirata+One&family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<title>{fullTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="brand">
				<Seal size={24} class="seal" />
				<a href={withBase(base)} style="color:inherit;">Morpheous</a>
			</div>
			<nav class="site-nav" aria-label="Main">
				<a href={withBase(base)} aria-current={currentPath === '/' ? 'page' : undefined}>
					Home
				</a>
				<a
					href={withBase(base, 'catalog/')}
					aria-current={currentPath.startsWith('/catalog') ? 'page' : undefined}
				>
					Catalog
				</a>
				<a
					href={withBase(base, 'about/')}
					aria-current={currentPath.startsWith('/about') ? 'page' : undefined}
				>
					About
				</a>
			</nav>
			<ThemeToggle />
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-brand">Morpheous</div>
			<div>A fan-made modelling &amp; terrain catalog. Not affiliated with any publisher.</div>
		</footer>
	</body>
</html>
