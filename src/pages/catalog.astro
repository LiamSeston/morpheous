---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import AssetGrid from '../components/AssetGrid.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('assets')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Catalog">
	<div class="container">
		<header class="page-header">
			<h1>Catalog</h1>
			<p>
				Every terrain piece, warband model, and miniature across every system I build for —
				filter by system or type to browse.
			</p>
		</header>

		<FilterBar entries={entries} />
		<AssetGrid entries={entries} />
	</div>
</BaseLayout>
