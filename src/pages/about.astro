---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
	<div class="container">
		<header class="page-header">
			<h1>About This Project</h1>
		</header>

		<article class="prose">
			<p>
				Morpheous is a living catalog of everything built on the tabletop — Mordheim terrain and
				warbands, Necromunda gangs, 40k miniatures, and whatever comes next — organized by what
				each piece actually is rather than which game it's from.
			</p>
			<p>
				Each entry tracks build status, materials, dimensions, and paint notes, with optional
				rotatable 3D scans for pieces that have been Blender-scanned. Add a new markdown file in
				<code>src/content/assets/</code> and drop photos into
				<code>public/images/</code> to catalogue your next piece.
			</p>
		</article>
	</div>
</BaseLayout>

<style>
	code {
		font-size: 0.9em;
		padding: 0.15em 0.4em;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.25rem;
	}
</style>
